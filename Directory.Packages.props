<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="LocalDb" Version="27.2.4" />
    <PackageVersion Include="EfLocalDb" Version="27.2.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="Verify.AngleSharp" Version="5.1.2" />
    <PackageVersion Include="Verify.EntityFramework" Version="16.1.1" />
    <PackageVersion Include="Verify.Http" Version="8.0.1" />
    <PackageVersion Include="Verify.ImageMagick" Version="4.0.0" />
    <PackageVersion Include="Verify.ImageSharp" Version="5.1.0" />
    <PackageVersion Include="Verify.Nunit" Version="33.3.3" />
    <PackageVersion Include="Verify.SqlServer" Version="12.3.1" />
    <PackageVersion Include="Verify.SystemJson" Version="1.4.1" />
    <PackageVersion Include="Verify.WinForms" Version="6.0.0" />
    <PackageVersion Include="Verify.Xaml" Version="5.0.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.3.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.abstractions" Version="2.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    <!-- transitive pin to avoid CVE. no direct PackageReference: net10.0 supplies it in the shared framework -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
    <PackageVersion Include="Argon" Version="0.38.2" />
    <PackageVersion Include="DiffEngine" Version="20.8.1" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.3.3" />
  </ItemGroup>
</Project>
